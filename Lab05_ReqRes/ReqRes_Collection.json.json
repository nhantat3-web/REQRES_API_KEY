      "name": "Positive_Cases",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Check name and job in response\", function () {\r\n    var jsonData = pm.response.json();\r\n    // Kiểm tra trực tiếp với chuỗi bạn đã nhập ở Body\r\n    pm.expect(jsonData.name).to.eql(\"An Nguyen\");\r\n    pm.expect(jsonData.job).to.eql(\"QA Lead\");\r\n});\r\n\r\npm.test(\"Extract and set userId\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.environment.set(\"userId\", jsonData.id);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{api-key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"An Nguyen\",\r\n  \"job\": \"QA Lead\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "response": []
        },
